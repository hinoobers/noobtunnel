# Everything else that Git detects as text is checked out with Unix line
# endings too, so a Windows checkout cannot break a script or an embedded asset.
* text=auto eol=lf

# Shell scripts must keep Unix line endings so they run on Linux targets.
*.sh text eol=lf

# Go sources are line ending agnostic but keep them consistent.
*.go text eol=lf

# Binaries must never be normalised.
dist/** -text
*.exe -text

# The checksum list is read by sha256sum on Linux, which treats a carriage
# return as part of the file name. Keep it Unix-only even when it is generated
# on a Windows machine.
dist/SHA256SUMS text eol=lf
