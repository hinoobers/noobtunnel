# Copy to /etc/noobtunnel/server.env and edit.
#
# The hostname this control node is published on. With it set, the web UI is
# served on https://<domain> over the shared HTTPS port and gets a Let's Encrypt
# certificate automatically (validated over port 80), so no browser warning and
# no port 443 given up to the control node. Agents keep dialing NOOBTUNNEL_LISTEN
# and pin the control node's own certificate, which never changes.
# NOOBTUNNEL_DOMAIN=noobtunnel.example.com
# NOOBTUNNEL_ACME_EMAIL=you@example.com

# The public address agents dial for WireGuard. Set this when the machine has
# several interfaces or sits behind a floating IP / NAT.
NOOBTUNNEL_PUBLIC_ENDPOINT=203.0.113.9:51820

# TLS listen address for the web UI, API and agent control channel.
NOOBTUNNEL_LISTEN=:8443

# Where state, keys and the TLS certificate live.
NOOBTUNNEL_STATE_DIR=/var/lib/noobtunnel

# WireGuard UDP port agents dial (also settable in the UI afterwards).
# NOOBTUNNEL_WG_PORT=51820

# Directory holding the agent binaries served to new machines.
NOOBTUNNEL_BINARY_DIR=/usr/local/share/noobtunnel

# Applied on first start only. After that, change it in the UI.
# NOOBTUNNEL_ADMIN_PASSWORD=change-me-before-first-start

# Mesh defaults (change in the UI afterwards).
# NOOBTUNNEL_MESH=10.77.0.0/16
# NOOBTUNNEL_INTERFACE=noobtun
# NOOBTUNNEL_DIRECT=true
# NOOBTUNNEL_SETUP_SYSTEM=true

# Log verbosity: debug, info, warn, error.
NOOBTUNNEL_LOG_LEVEL=info
